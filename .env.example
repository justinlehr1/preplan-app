# Template for local environment variables.
# Copy to .env.local and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# Only ever use the PUBLISHABLE key here (browser-safe, replaces the old "anon" key).
# NEVER put the "secret" / "service_role" key in this app.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
